<IfModule mod_rewrite.c>
    RewriteEngine On

    # Servir arquivos estáticos de public/ e fotos/ diretamente
    RewriteRule ^public/ - [L]
    RewriteRule ^fotos/ - [L]

    # Roteamento: tudo que não é arquivo existente passa pelo index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
